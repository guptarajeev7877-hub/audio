# --- separation engine ---------------------------------------------------
# "replicate" = runs Demucs in the cloud, no GPU needed, costs ~$0.02/track
# "local"     = runs Demucs on this machine, free, needs a GPU to be usable
SEPARATION_BACKEND=replicate

# Get this from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

REPLICATE_DEMUCS_MODEL=ryan5453/demucs
DEMUCS_MODEL=htdemucs

# --- server --------------------------------------------------------------
WORK_DIR=/tmp/reissue
MAX_UPLOAD_MB=60
JOB_TTL_MINUTES=90
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
